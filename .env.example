# --- LLM (optional: without a key the app falls back to a deterministic explainer) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_LLM=true

# --- Retrieval ---
EMBEDDER_BACKEND=sentence-transformers   # or: hashing (offline, tests only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_BACKEND=cross-encoder           # or: none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SEMANTIC_THRESHOLD=0.5

# --- App ---
API_URL=                                 # empty = Streamlit calls the pipeline in-process
MAX_UPLOAD_MB=5
